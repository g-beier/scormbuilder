{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCORM Builder",
  "version": "0.1.0",
  "identifier": "br.org.escoteirosrs.scormbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCORM Builder",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/index.html": "runtime/index.html",
      "../runtime/css/*.css": "runtime/css/",
      "../runtime/js/*.js": "runtime/js/",
      "../runtime/fonts/*.woff2": "runtime/fonts/",
      "../runtime/fonts/LICENSE-*.txt": "runtime/fonts/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "publisher": "Escoteiros do Brasil - RS",
    "shortDescription": "Construtor de pacotes SCORM 1.2 para o Campo Escola Virtual",
    "category": "Education"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTBFNzQ0MTdCNDRGNzEKUldSeFQ3UVhST2ZnVmYydEcrYUFJRUVKSVBGWnNlV3RsRnZsRS9lZjJKQlZldERJWERta2tMb3oK",
      "endpoints": [
        "https://github.com/g-beier/scormbuilder/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
